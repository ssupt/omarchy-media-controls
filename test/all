#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

python3 - "$ROOT/scripts/media-cover" "$ROOT/scripts/media-lyrics" <<'PY'
from pathlib import Path
import sys

for source in sys.argv[1:]:
    compile(Path(source).read_text(encoding="utf-8"), source, "exec")
print("PASS: helper syntax")
PY

command -v qmllint >/dev/null 2>&1 || fail "qmllint is required"
OMARCHY_ROOT=${OMARCHY_PATH:-/usr/share/omarchy}
[[ -d "$OMARCHY_ROOT/shell" ]] || fail "Omarchy shell imports not found under $OMARCHY_ROOT"
while IFS= read -r source; do
  qmllint -I "$OMARCHY_ROOT/shell" "$ROOT/$source" \
    || fail "QML validation: $source"
done < <(jq -r '.entryPoints[] | select(type == "string" and endswith(".qml"))' "$ROOT/manifest.json")
echo "PASS: QML syntax and imports"

node - "$ROOT/Model.js" "$ROOT/BarWidget.qml" "$ROOT/Service.qml" <<'JS'
const assert = require('node:assert/strict')
const fs = require('node:fs')
const model = require(process.argv[2])
const barSource = fs.readFileSync(process.argv[3], 'utf8')
const serviceSource = fs.readFileSync(process.argv[4], 'utf8')

assert.equal(model.metadataText({ 'xesam:url': 'file:///music/song.flac' }, 'xesam:url'), 'file:///music/song.flac')
assert.equal(model.metadataText({ 'xesam:artist': ['One', 'Two'] }, 'xesam:artist'), 'One, Two')
assert.equal(model.durationSeconds(225), 225)
assert.equal(model.durationSeconds(90000), 90000)
assert.equal(model.formatDuration(225), '3:45')
assert.equal(model.formatDuration(3725), '1:02:05')
assert.equal(model.formatDuration(90000), '25:00:00')
assert.equal(model.plainLyricsFromSynced('[ar:Artist]\n[00:01.20]First line\n[00:04.00]Second line'), 'First line\nSecond line')
assert.deepEqual(model.parseLyricsResponse(JSON.stringify({
  status: 'ok', syncedLyrics: '[00:01.20]First line', source: 'lrclib'
})), {
  status: 'ok', lyrics: 'First line', syncedLyrics: '[00:01.20]First line',
  source: 'lrclib', message: ''
})
assert.equal(model.nowPlayingLabel('Song', 'Artist'), 'Song  ·  Artist')
assert.equal(model.isVerticalPosition('top'), false)
assert.equal(model.isVerticalPosition('bottom'), false)
assert.equal(model.isVerticalPosition('left'), true)
assert.equal(model.isVerticalPosition('right'), true)
assert.equal(model.lyricsSourceLabel('embedded'), 'Embedded in audio file')

const stream = {
  dbusName: 'org.mpris.MediaPlayer2.stream', uniqueId: 7,
  trackTitle: 'Live stream', trackArtist: 'Station', trackAlbum: '',
  lengthSupported: false, length: 10, metadata: { 'xesam:url': 'https://example.test/live' }
}
const streamLater = { ...stream, length: 500 }
assert.equal(model.trackSignature(stream), model.trackSignature(streamLater))
assert.notEqual(model.trackSignature(stream), model.trackSignature({ ...stream, uniqueId: 8 }))

assert.match(barSource, /action: "previous"/)
assert.match(barSource, /action: "playPause"/)
assert.match(barSource, /action: "next"/)
assert.match(barSource, /horizontalLayout/)
assert.match(barSource, /verticalLayout/)
assert.match(barSource, /root\.openDetails\(\)/)
assert.match(barSource, /owner: panel/)
assert.match(barSource, /anchors\.verticalCenter: parent\.verticalCenter/)
assert.match(barSource, /status === Image\.Ready/)
assert.match(barSource, /requestLyrics/)
assert.match(barSource, /root\.lyricsDisplayText\(\)/)
assert.match(barSource, /activePlayer\.position = next/)
assert.match(serviceSource, /Quickshell\.Services\.Mpris/)
assert.match(serviceSource, /readonly property var players: Mpris\.players/)
assert.match(serviceSource, /activePlayer\.lengthSupported/)
assert.match(serviceSource, /target: "media"/)
console.log('PASS: media model and UI contract')
JS

python3 - "$ROOT/scripts/media-cover" "$ROOT/scripts/media-lyrics" <<'PY'
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import tempfile
import sys


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


cover = load("media_cover", sys.argv[1])
lyrics = load("media_lyrics", sys.argv[2])

plain, synced = lyrics.lyrics_from_probe({
    "format": {"tags": {"SYNCEDLYRICS": "[00:01.00]Hello\n[00:03.50]world"}}
})
assert plain == "Hello\nworld"
assert synced.startswith("[00:01.00]")

plain, synced = lyrics.lyrics_from_probe({
    "format": {"tags": {"LYRICS": "Line one\nLine two"}}
})
assert plain == "Line one\nLine two"
assert synced == ""

best = lyrics.best_search_result([
    {"trackName": "Different", "artistName": "Someone", "duration": 200},
    {"trackName": "The Song", "artistName": "The Artist", "albumName": "The Album", "duration": 225,
     "plainLyrics": "words"},
], "The Song", "The Artist", "The Album", 225)
assert best["plainLyrics"] == "words"
assert lyrics.normalized_name("Beyoncé") == "beyonce"
assert lyrics.normalized_name("你好") == "你好"
assert lyrics.normalized_name("Привет") == "привет"
assert lyrics.similarity("你好", "再见") < 1
assert lyrics.similarity("Привет", "До свидания") < 1

with tempfile.TemporaryDirectory() as directory:
    root = Path(directory)
    os.environ["XDG_CACHE_HOME"] = str(root / "cache")
    track = root / "song.flac"
    track.touch()
    image = root / "Cover.PNG"
    image.write_bytes(b"image")
    assert cover.local_path(track.as_uri()) == track
    assert cover.sidecar_cover(track) == image

    first_key = lyrics.cache_file("你好", "歌手", "专辑", 0)
    second_key = lyrics.cache_file("再见", "艺人", "唱片", 0)
    assert first_key is not None and second_key is not None
    assert first_key.name != second_key.name

    malformed = root / "malformed.json"
    malformed.write_text(json.dumps({"status": "not-found", "fetchedAt": "invalid"}))
    assert lyrics.read_cache(malformed) is None

    blocked_cache = root / "cache-file"
    blocked_cache.write_text("not a directory")
    os.environ["XDG_CACHE_HOME"] = str(blocked_cache)
    assert lyrics.cache_file("Track", "Artist", "", 0) is None
    assert cover.cache_path(track) is None
    lyrics.write_cache(None, {"status": "ok", "lyrics": "words"})

print("PASS: local media and lyrics helpers")
PY

jq -e '
  .schemaVersion == 1
  and .id == "ssupt.media-controls"
  and .version == "0.1.0"
  and .author == "ssupt"
  and (.kinds | index("service") != null)
  and (.kinds | index("bar-widget") != null)
  and (.kinds | index("panel") == null)
  and .entryPoints.service == "Service.qml"
  and .entryPoints.barWidget == "BarWidget.qml"
  and (.entryPoints | has("panel") | not)
  and .barWidget.defaultSection == "center"
  and .omarchy.clonedFrom == "omarchy.media"
' "$ROOT/manifest.json" >/dev/null || fail "manifest"
echo "PASS: manifest"
