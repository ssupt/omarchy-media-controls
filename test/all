import json
import os
from pathlib import Path
import socket
import stat
import subprocess
import sys
import tempfile
import time


launcher = Path(sys.argv[1])


def invoke(arguments, environment):
    completed = subprocess.run(
        [sys.executable, str(launcher), *arguments], env=environment,
        capture_output=True, text=True, check=False, timeout=15,
    )
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise AssertionError(f"invalid launcher response: {completed.stdout!r}") from error
    return completed, payload


def executable(path, body):
    path.write_text("#!/usr/bin/python3\n" + body, encoding="utf-8")
    path.chmod(path.stat().st_mode | stat.S_IXUSR)
    return path


def json_lines(path):
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line]


def stop_fake_mpv(socket_path):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1)
            client.connect(str(socket_path))
            client.sendall(json.dumps({
                "command": ["quit"], "request_id": "test-cleanup"
            }).encode("utf-8") + b"\n")
            client.recv(4096)
    except OSError:
        pass
    for _ in range(100):
        if not socket_path.exists():
            return
        time.sleep(0.01)


